{
  "name": "@erikwatson/react-snowfall",
  "version": "1.3.0",
  "description": "A React wrapper for @erikwatson/snowfall",
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "webpack serve --config webpack.dev.js",
    "build": "pnpm exec webpack --config webpack.prod.js && pnpm exec tsc --emitDeclarationOnly"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "@erikwatson/snowfall": "^4.4.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "html-webpack-plugin": "^5.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-loader": "^9.6.1",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5",
    "webpack-merge": "^6.0.1"
  },
  "keywords": [
    "snow",
    "snowfall",
    "christmas",
    "winter",
    "canvas",
    "particles",
    "holiday",
    "seasonal",
    "react"
  ],
  "files": [
    "dist/**/*"
  ]
}